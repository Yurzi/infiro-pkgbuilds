# Maintainer: Yurzi <yurzi@foxmail.com>

pkgname=pam-ssh-agent
pkgver=1.0.0
pkgrel=1
pkgdesc='PAM module for ssh-agent based authentication'
arch=('x86_64')
url='https://crates.io/crates/pam-ssh-agent'
license=('MIT')
makedepends=('cargo')
depends=('pam' 'sudo')
source=("$pkgname-$pkgver.tar.gz::https://static.crates.io/crates/$pkgname/$pkgname-$pkgver.crate")
sha256sums=('2ab3b79438e479b9181159c53458890e9e3584934b31f923a939d1935a293eae')

prepare() {
  export RUSTUP_TOOLCHAIN=stable
  cd $pkgname-$pkgver
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cd $pkgname-$pkgver
  # Do not use --all-features: it enables the "nativecrypto" feature, an
  # alternative, less-tested code path that breaks security-key auth
  # (sk-ssh-ed25519). See https://github.com/nresare/pam-ssh-agent/issues/105
  cargo build --frozen --release
}

check() {
  export RUSTUP_TOOLCHAIN=stable
  cd $pkgname-$pkgver
  cargo test --frozen
}

package() {
  cd $pkgname-$pkgver
  install -Dm755 target/release/libpam_ssh_agent.so -T "$pkgdir/usr/lib/security/pam_ssh_agent.so"
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname"
  install -Dm644 LICENSE-MIT -t "$pkgdir/usr/share/licenses/$pkgname"
}
