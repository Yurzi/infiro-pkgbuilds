# Maintainer: Yurzi <yurzi@foxmail.com>

pkgname=usbtree
pkgver=0.1.2
pkgrel=1
pkgdesc="Cross-platform TUI for inspecting the USB device tree"
arch=('x86_64')
url='https://github.com/gnomeria/usbtree'
license=('MIT')
depends=('glibc' 'libgcc')
makedepends=('rust')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/gnomeria/usbtree/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('09631627589b43ac2e93f6d2a1cf6a10e490f62a159396f35b6871180ad03617')

prepare() {
  export RUSTUP_TOOLCHAIN=stable
  cd "${pkgname}-${pkgver}"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cd "${pkgname}-${pkgver}"
  cargo build --frozen --release
}

check() {
  export RUSTUP_TOOLCHAIN=stable
  cd "${pkgname}-${pkgver}"
  cargo test --frozen
}

package() {
  cd "${pkgname}-${pkgver}"
  install -Dm755 target/release/usbtree "${pkgdir}/usr/bin/usbtree"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
