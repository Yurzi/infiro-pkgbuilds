pkgname=sakura-frpc
pkgver=0.51.0_sakura_15.1
pkgrel=1
pkgdesc="SakuraFrp client"
arch=('x86_64')
url="https://www.natfrp.com/"
license=('LicenseRef-custom')
provides=('sakura-frp' 'natfrp')
conflicts=('sakura-frp')
options=('!strip')

_upstreamver="${pkgver//_/-}"
source=(
  "sakura-frpc::https://nya.globalslb.net/natfrp/client/frpc/${_upstreamver}/frpc_linux_amd64"
  "sakura-frpc@.service"
  "sakura-frpc-tls@.service"
  "LICENSE::https://www.natfrp.com/policy/tos"
)
sha256sums=('f4d07fca61c9a048e17cb171597f49171ce55b1a8bc2e0ab4e2b4d86c444f402'
            'ae8d7af07c2c6264c6579cf77a516336b7448588047d139fa5e858c8f20dfcb6'
            '5a19b898213229f0a5993675d95a41cdec7865135ee24bfd600f180b7fa1ba0c'
            'c8ed831630add3ff8527f36be118580f995cf0d29950269a217ff087945cf13c')

package() {
  install -Dm755 "${srcdir}/sakura-frpc" "${pkgdir}/usr/bin/sakura-frpc"
  install -Dm644 "${srcdir}/sakura-frpc@.service" \
    "${pkgdir}/usr/lib/systemd/system/sakura-frpc@.service"
  install -Dm644 "${srcdir}/sakura-frpc-tls@.service" \
    "${pkgdir}/usr/lib/systemd/system/sakura-frpc-tls@.service"
  install -Dm644 "${srcdir}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
